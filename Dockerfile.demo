# jeeflow-moon demo（native 形态）
# 多阶段构建（2026-09-28 对齐 jeeflow-go demo-deploy 先例：小底座 + 二进制 + flows）：
# builder 层装工具链编译，运行层只带 ubuntu 底 + 产物二进制 + flows。
# 此前单阶段把 gcc/moon 工具链/_build 全留在镜像里（~1GB），scp 传镜像成为部署瓶颈
# （2026-09-28 服务器网络抖动时 Upload 卡死，run 36385242925 已取消）。
# 不直接照抄 goframe 的 alpine 底：moon native 产物动态链接 glibc，musl 有风险，
# 运行层沿用 ubuntu:22.04 与旧镜像同底座，保行为一致。
FROM ubuntu:22.04 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates git gcc libc-dev \
    && rm -rf /var/lib/apt/lists/*

# 工具链（latest；CI 已验证 latest 可构建/运行本仓 native demo）
RUN curl -fsSL https://cli.moonbitlang.com/install/unix.sh | bash
ENV PATH=/root/.moon/bin:$PATH

WORKDIR /app
# 先复制 workspace 清单（未来加依赖缓存层时再拆分）
COPY moon.work moon.work
COPY core core
COPY repository-mysql repository-mysql
COPY persist persist
COPY facade facade
COPY demo demo
# demo 种子：flows_dir() 候选路径解析到 /flows（WORKDIR=/app 的 ../../flows）
COPY flows /flows

RUN moon update && moon build --target native

# 产物动态定位（moon build 默认落 debug 目录；find 全 target 兜底），拷为固定路径
RUN BIN=$(find _build target -type f -name 'main*' -perm -u+x 2>/dev/null | head -1) \
    && [ -n "$BIN" ] \
    && cp "$BIN" /usr/local/bin/jeeflow-demo-bin \
    || (echo "=== binary not found, target tree:"; find _build target -type f -perm -u+x 2>/dev/null | head -40; exit 1)

# ---- 运行层 ----
FROM ubuntu:22.04
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/local/bin/jeeflow-demo-bin /usr/local/bin/jeeflow-demo-bin
WORKDIR /app
# flows 路径约定不变：resolver 候选 /flows
COPY flows /flows
EXPOSE 8092
CMD ["/usr/local/bin/jeeflow-demo-bin"]

# jeeflow-moon demo（native 形态）
# 对齐 rust 先例（jeeflow-rust/Dockerfile.demo）：CI ubuntu 构建，托管机 docker 常驻。
# 与 rust 的差异：本仓 demo 是 MoonBit native 产物（wasm 形态见 demo/cmd/main，由 moonrun 宿主）。
FROM ubuntu:22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates git gcc libc-dev \
    && rm -rf /var/lib/apt/lists/*

# 工具链（latest；CI 已验证 latest 可构建/运行本仓 native demo）
RUN curl -fsSL https://cli.moonbitlang.com/install/unix.sh | bash
ENV PATH=/root/.moon/bin:$PATH

WORKDIR /app
# 先复制 workspace 清单（未来加依赖缓存层时再拆分）
COPY moon.work moon.work
COPY core core
COPY repository-mysql repository-mysql
COPY persist persist
COPY facade facade
COPY demo demo

RUN moon update && moon build --target native

# 产物动态定位（moon build 默认落 debug 目录；find 全 target 兜底），拷为固定路径
RUN BIN=$(find target -type f -name 'main*' -perm -u+x | head -1) \
    && [ -n "$BIN" ] \
    && cp "$BIN" /usr/local/bin/jeeflow-demo-bin \
    || (echo "=== binary not found, target tree:"; find target -type f -perm -u+x | head -40; exit 1)

EXPOSE 8092
CMD ["/usr/local/bin/jeeflow-demo-bin"]

import {
  "mldong/jeeflow-demo" @demo,
  "mldong/jeeflow-core/json" @json,
  "moonbitlang/async",
  "moonbitlang/async/http" @http,
  "moonbitlang/async/socket" @socket,
  "moonbitlang/async/io" @io,
  "moonbitlang/core/encoding/utf8" @utf8,
  "moonbitlang/core/env" @env,
}
// `async fn main` 需要 import 本包；moonc 0.10.22 的 unused_package 不计这一用法，包级压掉。
warnings = "-unused_package"

pkgtype(kind: "executable")

supported_targets = "+native+wasm"

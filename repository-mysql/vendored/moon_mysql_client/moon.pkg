// vendored 自 moonbitstack/moonmysql@0.4.0 的 client 包（conn.mbt/driver.mbt 原样拷贝）。
// vendored 原因：上游 client/moon.pkg 声明 supported_targets = "native"，
// 而本仓开发主循环要求 wasm（方案 §2.3/§2.4，decisions-log.md D-M0-2）。
// 0.4.0（mooncakes 从 Lfan-ke/moon-mysql 迁到 moonbitstack/moonmysql）复测：该限制**仍未放开**，
// 本 vendored 解锁继续有效；两文件相对 0.3.1 仅 @moon_mysql→@moonmysql 别名改名，零逻辑变化。
// 实测：解锁限制后 wasm 下连接/建表/查询/begin-commit-rollback 全通（开发服务器 MySQL 8）。
// 升级策略：跟上游重新拷贝 + 重跑 T1 smoke；root codec 包仍走 registry 不 vendor。
import {
  "moonbitstack/moonmysql" @moonmysql,
  "moonbitstack/moondb",
  "moonbitlang/async",
  "moonbitlang/async/socket",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
}
